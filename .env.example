# Docker Compose 部署示例：复制为 .env 后再按需修改。
# .env 会被 Git 忽略；不要在 .env.example 中填入真实口令。

# 构建基线固定到 Node/Alpine 补丁版本。生产 CI 可改为同标签加经核验的
# 多架构 manifest digest，例如 node:22.23.2-alpine3.24@sha256:<实际摘要>。
JMW_NODE_IMAGE=node:22.23.2-alpine3.24

# 仅使用 docker-compose.ghcr.yml 部署预构建镜像时生效。默认镜像地址见该文件；
# 如果使用自己的镜像仓库或版本标签，可取消下一行注释并替换地址。
# JMW_IMAGE=ghcr.io/shixian64/jm-web:latest

# 单实例资源与 Docker stdout/stderr 日志上限。
JMW_CPU_LIMIT=1.0
JMW_MEMORY_LIMIT=512m
JMW_PIDS_LIMIT=256
JMW_LOG_MAX_SIZE=10m
JMW_LOG_MAX_FILE=3

# 默认只发布到宿主机回环地址，适合同机 Nginx/Caddy 反向代理。
# 需要局域网直连时可改为 0.0.0.0，但务必同时设置高强度 ACCESS_PASSWORD。
JMW_PUBLISH_HOST=127.0.0.1
JMW_PUBLISH_PORT=3210

# 容器内端口（1-65535）；Compose 会自动使健康检查和端口映射与它保持一致。
PORT=3210

# 容器/NAT/反代部署请填入独立的高熵随机口令（至少 16 字节）；留空表示普通功能不启用访问保护，
# 且日志、DoH 修改/测速等运维能力会 fail closed（仅直接 TCP 回环可无口令使用）。
ACCESS_PASSWORD=

# 上游 API；留空使用项目内置候选。
JM_API_BASE=
JM_UA=okhttp/4.9.3
JM_TIMEOUT=20000
JM_TOTAL_TIMEOUT=35000

# 响应体/并发资源上限。字节数会被后端钳制到各自允许范围。
JMW_MAX_CHAPTER_IMAGES=2000
JMW_MAX_IMAGE_BYTES=26214400
JMW_MAX_IMAGE_CONCURRENCY=12
JMW_MAX_IMAGE_CONCURRENCY_PER_IP=6
# 仅缓存 albums/library/album/novels 下的小型封面；章节正文仍走流式转发。
JMW_IMAGE_CACHE_BYTES=67108864
JMW_IMAGE_CACHE_ENTRY_BYTES=2097152
JMW_IMAGE_CACHE_TTL=86400
JMW_IMAGE_QUEUE_LIMIT=96
JMW_IMAGE_QUEUE_TIMEOUT=3000
JMW_MAX_API_RESPONSE_BYTES=16777216
JMW_MAX_AI_STREAM_BYTES=16777216
JMW_MAX_AI_CONCURRENCY=4
JMW_MAX_SEARCH_CONCURRENCY=8

# 额外可信反向代理的精确 IP/CIDR，逗号分隔。回环代理默认已可信。
# 不要填 1、true 或 *；若 Nginx 经 Docker 网桥访问，请填其实际网关 IP/子网。
JMW_TRUST_PROXY=

# 可选 AI 对话（OpenAI-compatible /chat/completions SSE 接口）。
# API Key 只保存在服务器环境变量中，不会发送给浏览器或写入备份。
AI_API_KEY=
AI_BASE_URL=https://newapi.shixian.me/v1
AI_MODEL=grok-4.6
AI_TIMEOUT=120000

# 后台章节视觉分析（与用户 AI 对话共用上面的 AI_API_KEY / AI_BASE_URL / AI_MODEL）。
# 默认只处理一个完整章节；管理员可提高并发，章节内图片仍按顺序发送。
CHAPTER_AI_INTERVAL_MS=30000
CHAPTER_AI_CONCURRENCY=1
CHAPTER_AI_MAX_RETRIES=3

# 可选 Tavily 搜索提供商。留空时仍可使用内置公开搜索引擎。
TAVILY_API_KEY=

# 可选自建 SearXNG（必须为公网可解析的 HTTPS 基址，不要以 /search 结尾）。
SEARXNG_BASE_URL=

# 联网搜索总时间预算（毫秒，最大 60000）。
SEARCH_TIMEOUT=35000

# 可选更新检查，格式为 GitHub 的 owner/repo；留空时只显示当前版本。
JMW_UPDATE_REPO=

# 宿主机持久化目录。容器内固定挂载到 /app/data；请勿随代码分发或提交。
# Compose 不会自动创建该路径。Linux 部署前须创建并授权给 uid/gid 1000。
JMW_HOST_DATA_DIR=./data
